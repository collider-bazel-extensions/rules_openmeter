#!/usr/bin/env bash
# openmeter_server wrapper: resolves runfiles, execs the launcher.
# Substitution markers use __KEY__ syntax to avoid colliding with bash.
set -euo pipefail

if [[ -z "${RUNFILES_DIR:-}" ]]; then
  if [[ -n "${TEST_SRCDIR:-}" && -d "${TEST_SRCDIR}" ]]; then RUNFILES_DIR="$TEST_SRCDIR"
  elif [[ -d "${0}.runfiles" ]]; then RUNFILES_DIR="$(cd "${0}.runfiles" && pwd)"
  fi
  : "${RUNFILES_DIR:?openmeter_server: no runfiles found; run it with bazel run / bazel test}"
  export RUNFILES_DIR
fi

resolve() {
  local p="$1"
  for c in "${RUNFILES_DIR}/_main/${p}" "${RUNFILES_DIR}/${p}" "${RUNFILES_DIR}/${p#../}"; do
    [[ -e "$c" ]] && { printf '%s\n' "$c"; return; }
  done
  echo "openmeter_server: not in runfiles: ${p}" >&2
  exit 1
}

name='__NAME__'
tmp="${TEST_TMPDIR:-}"
if [[ -z "$tmp" ]]; then
  # `bazel run`: no TEST_TMPDIR. The backing servers' env files are looked
  # for here too, so run them with the same TEST_TMPDIR (or pass
  # --kafka-env / --clickhouse-env / --postgres-env).
  tmp="${TMPDIR:-/tmp}"
  echo "[openmeter] TEST_TMPDIR not set; using $tmp" >&2
fi

# Resolved into variables first: a failing $(resolve) inside an argument
# list would not stop the script under `set -e`.
launcher="$(resolve '__LAUNCHER__')"
server="$(resolve '__SERVER__')"
sink_worker="$(resolve '__SINK_WORKER__')"
opts=()
__METERS__

exec python3 -I "$launcher" serve \
  --name "$name" \
  --server "$server" \
  --sink-worker "$sink_worker" \
  --version '__VERSION__' \
  --env-file "$tmp/$name.env" \
  --state-dir "$tmp/$name" \
  --kafka-env "$tmp/__KAFKA__.env" \
  --clickhouse-env "$tmp/__CLICKHOUSE__.env" \
  --postgres-env "$tmp/__POSTGRES__.env" \
  ${opts[@]+"${opts[@]}"} __OPTS__ "$@"
