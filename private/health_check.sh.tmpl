#!/usr/bin/env bash
# openmeter_health_check: exits 0 iff the paired openmeter_server (or
# openmeter_stack) has written its env file (it does so only once
# GET /api/v1/meters answers and the sink worker consumes the events topic).
set -euo pipefail

env_file="${TEST_TMPDIR:-${TMPDIR:-/tmp}}/__ENV_FILE_NAME__"
if [[ -f "$env_file" ]]; then
  exit 0
fi
echo "[openmeter_health_check] env file not yet present: $env_file" >&2
exit 1
